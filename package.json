{
  "name": "pelis",
  "version": "1.0.0",
  "private": true,
  "description": "Cat\u00e1logo est\u00e1tico de pel\u00edculas y series con fuentes de reproducci\u00f3n legales y configurables",
  "scripts": {
    "check:player": "node scripts/check-player-sources.mjs",
    "scrape": "node scraper/scrape.mjs",
    "update": "node scraper/update.mjs",
    "enrich": "node scripts/enrich-tmdb.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check": "npm run -s check:player && npm run -s check:routes && npm run -s check:pages",
    "dev": "node scripts/dev-server.mjs",
    "check:pages": "PREFIX=/pelis FALLBACK=404 node scripts/check-routes.mjs",
    "dev:pages": "SERVE_PREFIX=/pelis node scripts/dev-server.mjs",
    "publish:web": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
