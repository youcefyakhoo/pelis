  "notice": "Fuentes del reproductor configuradas con Cuevana 3 (tungtungsahur.cuevana3c.pro). El sitio usa un wrapper con base64 para ocultar las URLs reales de streaming.",
  "sources": [
    {
      "id": "cuevana3",
      "name": "Cuevana 3",
      "kind": "embed",
      "enabled": true,
      "order": 1,
      "appliesTo": ["movie", "series"],
      "url": "https://tungtungsahur.cuevana3c.pro/?v={base64}",
      "episodeUrl": "https://tungtungsahur.cuevana3c.pro/?v={base64}",
      "note": "El cliente debe codificar en base64 la URL: https://vidapi.xyz/embed/movie/{tmdb} o https://vidapi.xyz/embed/tv/{tmdb}?season={season}&episode={episode}"
    },
    {
      "id": "vidapi-direct",
      "name": "VidAPI Directo",
      "kind": "embed",
      "enabled": false,
      "order": 2,
      "appliesTo": ["movie", "series"],
      "url": "https://vidapi.xyz/embed/movie/{tmdb}",
      "episodeUrl": "https://vidapi.xyz/embed/tv/{tmdb}?season={season}&episode={episode}"
    },
    {
      "id": "trailer-embed",
